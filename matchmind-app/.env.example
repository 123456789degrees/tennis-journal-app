# Copy this file to .env and fill in your real key.
# .env is gitignored — the real key never gets committed.
#
# Get a key at https://openrouter.ai/keys (sign up, add a little credit, create a key).
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models — this default is cheap and solid.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Get a key at https://console.cloud.google.com/apis/credentials — enable
# "YouTube Data API v3" on the project first, then create an API key.
# Optional: drill suggestions fall back to a plain search link without it.
YOUTUBE_API_KEY=

# Supabase — Project Settings -> API in your Supabase dashboard.
# EXPO_PUBLIC_* vars are bundled into the client (that's fine here: the
# anon key is meant to be public, access is controlled by row-level
# security instead — see supabase/schema.sql).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER prefix this one with EXPO_PUBLIC_ — it must stay server-only.
# Used only by api/delete-account.js. Needed in Vercel's project env vars
# for production; only needed locally if you run `vercel dev` to test that
# one endpoint.
SUPABASE_SERVICE_ROLE_KEY=
