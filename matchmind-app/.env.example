# Copy this file to .env and fill in your real key.
# .env is gitignored — the real key never gets committed.
#
# Get a key at https://openrouter.ai/keys (sign up, add a little credit, create a key).
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models — this default is cheap and solid.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Get a key at https://console.cloud.google.com/apis/credentials — enable
# "YouTube Data API v3" on the project first, then create an API key.
# Optional: drill suggestions fall back to a plain search link without it.
YOUTUBE_API_KEY=
